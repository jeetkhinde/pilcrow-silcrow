{
  "tools": {
    "allowedTools": [
      "read_file",
      "list_directory",
      "search_files",
      "run_shell_command(printf)",
      "run_shell_command(ls)",
      "run_shell_command(dir)",
      "run_shell_command(pwd)",
      "run_shell_command(cat)",
      "run_shell_command(which)",
      "run_shell_command(tree)",
      "run_shell_command(find)",
      "run_shell_command(fd)",
      "run_shell_command(grep)",
      "run_shell_command(ag)",
      "run_shell_command(rg)",
      "run_shell_command(ctags)",
      "run_shell_command(cscope)",
      "run_shell_command(mkdir)",
      "run_shell_command(touch)",
      "run_shell_command(graphify)",
      "run_shell_command(graphify update .)",
      "run_shell_command(git)",
      "run_shell_command(git status)",
      "run_shell_command(git log)",
      "run_shell_command(git diff)",
      "run_shell_command(git branch)",
      "run_shell_command(make)",
      "run_shell_command(mvn)",
      "run_shell_command(gradle)",
      "run_shell_command(npm)",
      "run_shell_command(yarn)",
      "run_shell_command(pip)",
      "run_shell_command(poetry)",
      "run_shell_command(docker)",
      "run_shell_command(kubectl)",
      "run_shell_command(helm)",
      "run_shell_command(terraform)",
      "run_shell_command(ansible)",
      "run_shell_command(aws)",
      "run_shell_command(gcloud)",
      "run_shell_command(az)"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,pathlib,json;e=pathlib.Path('graphify-out/graph.json').exists();d={'decision':'allow'};e and d.update({'additionalContext':'graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.'});sys.stdout.write(json.dumps(d))\""
          }
        ]
      }
    ]
  }
}